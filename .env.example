# ─────────────────────────────────────────────────────────────────────────────
# AuditPilot — environment variables
# Copy to `.env` for local development. Do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/auditpilot

# Auth — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token encryption at rest (AES-256-GCM) — REQUIRED from security hardening step.
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# GitHub OAuth App (current mode)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of *this API* that GitHub redirects back to, e.g. http://localhost:5000/api/auth/github/callback
GITHUB_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub App (new mode — used once modular-monolith + webhook work lands)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
# PEM contents, base64-encoded (multiline-safe)
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_NAME=
GITHUB_WEBHOOK_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
# REQUIRED in production — webhook payloads are rejected without signature verification
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# AI provider (OpenAI-compatible; OpenRouter by default)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Model routing (configured per plan in a later step)
AI_MODEL_TRIAGE=
AI_MODEL_DEEP=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment (frontend deployed statically; API runs as long-lived service)
# ─────────────────────────────────────────────────────────────────────────────
# CORS allowlist for the browser client, comma-separated
CLIENT_ORIGIN=http://localhost:5000,http://localhost:5173
# Base URL the browser uses to reach the API (empty = same-origin)
VITE_API_BASE=

# Logging
LOG_LEVEL=info
